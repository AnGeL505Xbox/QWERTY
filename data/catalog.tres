[resource]
script = ExtResource("script")
cards = Array[ExtResource("cards_type")]([ExtResource("cards_corte"), ExtResource("cards_velo"), ExtResource("cards_pulso"), ExtResource("cards_destello"), ExtResource("cards_lectura"), ExtResource("cards_reserva"), ExtResource("cards_refugio"), ExtResource("cards_aguja"), ExtResource("cards_eco_noa"), ExtResource("cards_sutura"), ExtResource("cards_calma"), ExtResource("cards_impulso"), ExtResource("cards_bastion"), ExtResource("cards_aurora"), ExtResource("cards_estocada"), ExtResource("cards_paso_bruma"), ExtResource("cards_respiro"), ExtResource("cards_farol"), ExtResource("cards_marea"), ExtResource("cards_eco_reflejado")])
characters = Array[ExtResource("characters_type")]([ExtResource("characters_lira"), ExtResource("characters_noa")])
enemies = Array[ExtResource("enemies_type")]([ExtResource("enemies_eco"), ExtResource("enemies_custodio"), ExtResource("enemies_susurro"), ExtResource("enemies_espinero")])
statuses = Array[ExtResource("statuses_type")]([ExtResource("statuses_strength"), ExtResource("statuses_ward"), ExtResource("statuses_fragile")])
team = Array[ExtResource("characters_type")]([ExtResource("characters_lira"), ExtResource("characters_noa")])
hand_size = 5
